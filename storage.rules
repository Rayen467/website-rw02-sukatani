rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function masuk() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function petugas() {
      return masuk()
        && request.auth.token.email is string
        && firestore.exists(
             /databases/(default)/documents/pengurus/$(request.auth.token.email)
           );
    }

    match /video-kegiatan/{namaFile} {
      allow read: if true;

      allow create, update: if petugas()
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');

      allow delete: if petugas();
    }

    match /{semua=**} {
      allow read, write: if false;
    }
  }
}
